# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings -> API Keys).
#
# Do NOT commit .env.local - it is gitignored.
#
# The publishable key format is sb_publishable_xxxxx
# The legacy anon key format is eyJxxxxx (a JWT)
# Either works with @supabase/supabase-js.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here